rules_version = '2';

// กฎ Firebase Storage สำหรับ PLAS WMS (รูปโปรไฟล์ + รูปแจ้งปัญหา)
// Deploy: Firebase Console > Storage > Rules  (หรือ firebase deploy --only storage)
service firebase.storage {
  match /b/{bucket}/o {

    // รูปโปรไฟล์ผู้ใช้
    match /profile_photos/{fileName} {
      allow read: if true;                 // แสดงรูปได้ทุกคน (รูปโปรไฟล์ไม่ลับ)
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // (เผื่ออนาคต) รูปแจ้งปัญหา
    match /issue_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ปฏิเสธที่เหลือ
    match /{allPaths=**} { allow read, write: if false; }
  }
}
