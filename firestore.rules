rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Firestore rules สำหรับ PLAS WMS
// ต้องล็อกอินก่อน (anonymous auth ของแอปก็ผ่าน) ถึงจะอ่าน/เขียนได้
// ปิดไม่ให้คนนอก (ไม่ผ่าน auth) แตะ DB ได้
// Deploy: Firebase Console > Firestore Database > Rules > วาง > Publish
//         หรือ  firebase deploy --only firestore:rules
// ⚠️ ถ้าล็อกเอาต์/พังหลัง publish ให้ revert เป็น  if true  ชั่วคราว
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
